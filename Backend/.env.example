# Database Configuration
# Default is local SQLite database
DATABASE_URL=sqlite:///./mindease.db

# App Settings
APP_ENV=development
APP_NAME=MindEase-AI
DEBUG=True

# API Settings
API_V1_PREFIX=/api/v1

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI companion; backend works without this key
# GROQ_API_KEY=replace-with-your-key
